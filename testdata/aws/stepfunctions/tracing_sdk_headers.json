  "source": "import json, os, sys, time, uuid\nfrom pathlib import Path\nsys.path.insert(0, '/home/r/dev/minor/stackd/scripts/aws')\nfrom aws_cli import observe\n\nenv = dict(os.environ, AWS_REGION='us-west-2', AWS_DEFAULT_REGION='us-west-2', AWS_PAGER='', AWS_MAX_ATTEMPTS='1')\nfor key in list(env):\n    if key.startswith('AWS_ENDPOINT_URL'):\n        del env[key]\nprefix = 'stackd-trace-edge-' + uuid.uuid4().hex[:10]\nresult = {'prefix': prefix, 'region': 'us-west-2', 'observations': [], 'source': Path(__file__).read_text()}\npath = Path('/tmp/stackd-native-trace-boundary.json')\nrole = queue = machine = None\nroots = {}\n\ndef call(label, service, operation, payload):\n    start = int(time.time() * 1000)\n    response = observe(service, operation, payload, env, paginate=False)\n    result['observations'].append({'label': label, 'service': service, 'operation': operation, 'input': payload, 'request_started_ms': start, 'request_finished_ms': int(time.time() * 1000), 'result': response})\n    path.write_text(json.dumps(result, indent=2) + '\\n')\n    return response\n\ndef success(response):\n    if response['code'] != 'Success':\n        raise RuntimeError(response)\n    return response['output']\n\ntry:\n    trust = {'Version': '2012-10-17', 'Statement': [{'Effect': 'Allow', 'Principal': {'Service': 'states.amazonaws.com'}, 'Action': 'sts:AssumeRole', 'Condition': {'StringEquals': {'aws:SourceAccount': '000000000000'}}}]}\n    role = success(call('role', 'iam', 'create-role', {'RoleName': prefix, 'AssumeRolePolicyDocument': json.dumps(trust)}))['Role']['Arn']\n    queue = success(call('queue', 'sqs', 'create-queue', {'QueueName': prefix}))['QueueUrl']\n    policy = {'Version': '2012-10-17', 'Statement': [{'Effect': 'Allow', 'Action': ['xray:PutTraceSegments', 'xray:PutTelemetryRecords', 'xray:GetSamplingRules', 'xray:GetSamplingTargets'], 'Resource': '*'}, {'Effect': 'Allow', 'Action': 'sqs:SendMessage', 'Resource': 'arn:aws:sqs:us-west-2:000000000000:' + prefix}]}\n    success(call('policy', 'iam', 'put-role-policy', {'RoleName': prefix, 'PolicyName': 'owned', 'PolicyDocument': json.dumps(policy)}))\n    definition = {'StartAt': 'Send', 'States': {'Send': {'Type': 'Task', 'Resource': 'arn:aws:states:::aws-sdk:sqs:sendMessage', 'Parameters': {'QueueUrl': queue, 'MessageBody.$': '$.label'}, 'End': True}}}\n    time.sleep(12)\n    machine = success(call('machine', 'stepfunctions', 'create-state-machine', {'name': prefix, 'roleArn': role, 'definition': json.dumps(definition), 'tracingConfiguration': {'enabled': True}}))['stateMachineArn']\n    for label, sample in [('enabled-zero', '0'), ('enabled-one', '1'), ('disabled-absent', None)]:\n        if sample is None:\n            success(call('disable', 'stepfunctions', 'update-state-machine', {'stateMachineArn': machine, 'tracingConfiguration': {'enabled': False}}))\n            time.sleep(8)\n        request = {'stateMachineArn': machine, 'name': label, 'input': json.dumps({'label': label})}\n        if sample is not None:\n            root = f'1-{int(time.time()):08x}-{uuid.uuid4().hex[:24]}'\n            roots[label] = root\n            request['traceHeader'] = f'Root={root};Parent=0123456789abcdef;Sampled={sample}'\n        execution = success(call(label + '-start', 'stepfunctions', 'start-execution', request))['executionArn']\n        for index in range(20):\n            described = success(call(label + '-describe-' + str(index), 'stepfunctions', 'describe-execution', {'executionArn': execution}))\n            if described['status'] != 'RUNNING':\n                break\n            time.sleep(1)\n        assert described['status'] == 'SUCCEEDED', described\n    messages = []\n    for index in range(3):\n        reply = success(call('receive-' + str(index), 'sqs', 'receive-message', {'QueueUrl': queue, 'MaxNumberOfMessages': 10, 'MessageSystemAttributeNames': ['AWSTraceHeader'], 'WaitTimeSeconds': 1}))\n        messages.extend(reply.get('Messages', []))\n        if len(messages) == 3:\n            break\n    assert len(messages) == 3, messages\n    for message in messages:\n        header = message.get('Attributes', {}).get('AWSTraceHeader')\n        if header is not None:\n            fields = dict(part.split('=', 1) for part in header.split(';'))\n            roots.setdefault(message['Body'], fields['Root'])\n    result['roots'] = roots\n    for index in range(3):\n        if index:\n            time.sleep(20)\n        reply = success(call('trace-read-' + str(index), 'xray', 'batch-get-traces', {'TraceIds': list(roots.values())}))\n        print(json.dumps({'poll': index, 'traces': [(entry['Id'], len(entry['Segments'])) for entry in reply['Traces']]}), flush=True)\nfinally:\n    if machine:\n        call('cleanup-machine', 'stepfunctions', 'delete-state-machine', {'stateMachineArn': machine})\n    if queue:\n        call('cleanup-queue', 'sqs', 'delete-queue', {'QueueUrl': queue})\n    if role:\n        call('cleanup-policy', 'iam', 'delete-role-policy', {'RoleName': prefix, 'PolicyName': 'owned'})\n        call('cleanup-role', 'iam', 'delete-role', {'RoleName': prefix})\n    path.write_text(json.dumps(result, indent=2) + '\\n')\n",
  "roots": {
    "enabled-zero": "1-6ab4ae18-fab1c0fbd255432baee317a0",
