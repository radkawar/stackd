    "text": "#!/usr/bin/env python3\n\"\"\"Owned, bounded Step Functions SDK request capture; removed after integration.\"\"\"\nimport base64\nfrom datetime import datetime, timezone\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport time\nimport uuid\n\nimport aws_cli\n\nACCOUNT = \"000000000000\"\nREGION = \"us-west-2\"\nPREFIX = \"stackd-sfn-sdk-\" + uuid.uuid4().hex[:12]\nDEST = Path(\"testdata/aws/stepfunctions/sdk_requests.json\")\nENV = {key: value for key, value in os.environ.items() if not key.startswith(\"AWS_ENDPOINT_URL\")}\nENV.update(AWS_REGION=REGION, AWS_DEFAULT_REGION=REGION, AWS_PAGER=\"\")\nrecord = {\n    \"account\": ACCOUNT, \"region\": REGION, \"prefix\": PREFIX,\n    \"captured_at\": datetime.now(timezone.utc).isoformat(),\n    \"source\": {\"path\": str(Path(__file__)), \"revision\": \"b79ebb8\", \"text\": Path(__file__).read_text()},\n    \"official_urls\": [\n        \"https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObject.html\",\n        \"https://docs.aws.amazon.com/step-functions/latest/apireference/API_TestState.html\",\n        \"https://docs.aws.amazon.com/step-functions/latest/dg/supported-services-awssdk.html\",\n    ],\n    \"observations\": [],\n}\n\n\ndef observe(label, service, operation, parameters):\n    started = int(time.time() * 1000)\n    result = aws_cli.observe(service, operation, parameters, ENV, paginate=False)\n    record[\"observations\"].append({\n        \"label\": label, \"service\": service, \"operation\": operation,\n        \"input\": parameters, \"request_started_ms\": started,\n        \"request_finished_ms\": int(time.time() * 1000), \"result\": result,\n    })\n    return result\n\n\ndef required(label, service, operation, parameters):\n    result = observe(label, service, operation, parameters)\n    if result[\"code\"] != \"Success\":\n        raise RuntimeError(f\"{label}: {result['code']}\")\n    return result[\"output\"]\n\n\ndef test(label, operation, parameters):\n    request = {\n        \"definition\": json.dumps({\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:s3:\" + operation,\n                                  \"Parameters\": parameters, \"End\": True}, separators=(\",\", \":\")),\n        \"roleArn\": role_arn, \"input\": \"{}\", \"inspectionLevel\": \"INFO\",\n    }\n    for attempt in range(8):\n        result = observe(label if attempt == 0 else f\"{label}-role-retry-{attempt}\",\n                         \"stepfunctions\", \"test-state\", request)\n        output = result.get(\"output\", {})\n        if not (output.get(\"error\") == \"States.TaskFailed\" and\n                output.get(\"cause\", \"\").startswith(\"The principal states.amazonaws.com is not authorized to assume\")):\n            return output\n        time.sleep(2)\n    raise RuntimeError(\"owned execution role did not become usable for \" + label)\n\n\nrole_created = bucket_created = policy_created = False\nkeys = []\ntry:\n    actor = required(\"caller\", \"sts\", \"get-caller-identity\", {})\n    if actor[\"Account\"] != ACCOUNT:\n        raise RuntimeError(\"native account does not match authorized capture scope\")\n    role = required(\"create-role\", \"iam\", \"create-role\", {\n        \"RoleName\": PREFIX,\n        \"AssumeRolePolicyDocument\": json.dumps({\"Version\": \"2012-10-17\", \"Statement\": [\n            {\"Effect\": \"Allow\", \"Principal\": {\"Service\": \"states.amazonaws.com\"}, \"Action\": \"sts:AssumeRole\"}\n        ]}),\n    })\n    role_created = True\n    role_arn = role[\"Role\"][\"Arn\"]\n    required(\"role-policy\", \"iam\", \"put-role-policy\", {\n        \"RoleName\": PREFIX, \"PolicyName\": \"owned-bucket\",\n        \"PolicyDocument\": json.dumps({\"Version\": \"2012-10-17\", \"Statement\": [\n            {\"Effect\": \"Allow\", \"Action\": \"s3:ListBucket\", \"Resource\": \"arn:aws:s3:::\" + PREFIX},\n            {\"Effect\": \"Allow\", \"Action\": [\"s3:PutObject\", \"s3:GetObject\"], \"Resource\": \"arn:aws:s3:::\" + PREFIX + \"/*\"},\n        ]}),\n    })\n    policy_created = True\n    required(\"create-bucket\", \"s3api\", \"create-bucket\", {\n        \"Bucket\": PREFIX, \"CreateBucketConfiguration\": {\"LocationConstraint\": REGION},\n    })\n    bucket_created = True\n    for attempt in range(8):\n        ready = test(f\"role-readiness-{attempt}\", \"listObjectsV2\", {\"Bucket\": PREFIX})\n        if ready.get(\"status\") == \"SUCCEEDED\":\n            break\n        time.sleep(2)\n    else:\n        raise RuntimeError(\"owned execution role did not become usable\")\n    body = {\"message\": \"sdk-checksum-control\"}\n    checksum = base64.b64encode(hashlib.sha256(json.dumps(body, separators=(\",\", \":\")).encode()).digest()).decode()\n    for label, checksum_parameters in [\n        (\"default-checksum\", {}),\n        (\"explicit-sha256\", {\"ChecksumSHA256\": checksum}),\n        (\"algorithm-sha256\", {\"ChecksumAlgorithm\": \"SHA256\"}),\n        (\"conflicting-algorithm\", {\"ChecksumAlgorithm\": \"CRC32\", \"ChecksumSHA256\": checksum}),\n        (\"invalid-sha256\", {\"ChecksumSHA256\": base64.b64encode(bytes(32)).decode()}),\n    ]:\n        keys.append(label)\n        outcome = test(label, \"putObject\", {\"Bucket\": PREFIX, \"Key\": label, \"Body\": body, **checksum_parameters})\n        if outcome.get(\"status\") == \"SUCCEEDED\":\n            test(label + \"-retained\", \"headObject\", {\"Bucket\": PREFIX, \"Key\": label, \"ChecksumMode\": \"ENABLED\"})\n    for label, flag in [(\"boolean-true\", True), (\"string-true\", \"true\"), (\"string-false\", \"false\"),\n                        (\"string-invalid\", \"not-a-boolean\"), (\"numeric-boolean\", 1),\n                        (\"numeric-zero\", 0), (\"numeric-negative\", -1),\n                        (\"string-upper-trim\", \" TRUE \"), (\"string-empty\", \"\"), (\"string-null\", \"null\")]:\n        test(label, \"listObjectsV2\", {\"Bucket\": PREFIX, \"FetchOwner\": flag})\nfinally:\n    if bucket_created:\n        for key in keys:\n            observe(\"cleanup-object-\" + key, \"s3api\", \"delete-object\", {\"Bucket\": PREFIX, \"Key\": key})\n        observe(\"cleanup-bucket\", \"s3api\", \"delete-bucket\", {\"Bucket\": PREFIX})\n        observe(\"cleanup-bucket-absent\", \"s3api\", \"head-bucket\", {\"Bucket\": PREFIX})\n    if policy_created:\n        observe(\"cleanup-policy\", \"iam\", \"delete-role-policy\", {\"RoleName\": PREFIX, \"PolicyName\": \"owned-bucket\"})\n    if role_created:\n        observe(\"cleanup-role\", \"iam\", \"delete-role\", {\"RoleName\": PREFIX})\n        observe(\"cleanup-role-absent\", \"iam\", \"get-role\", {\"RoleName\": PREFIX})\n    DEST.write_text(json.dumps(record, indent=2) + \"\\n\")\n    print(json.dumps({\"prefix\": PREFIX, \"results\": [\n        {\"label\": row[\"label\"], \"code\": row[\"result\"][\"code\"],\n         \"status\": row[\"result\"].get(\"output\", {}).get(\"status\"),\n         \"error\": row[\"result\"].get(\"output\", {}).get(\"error\")}\n        for row in record[\"observations\"]\n    ]}, indent=2))\n"
