  "source": "import datetime\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport sys\nimport uuid\n\nROOT = Path('/home/r/dev/minor/stackd')\nsys.path.insert(0, str(ROOT / 'scripts/aws'))\nfrom aws_cli import observe\n\nENV = {k: v for k, v in os.environ.items() if not k.startswith('AWS_ENDPOINT_URL')}\nENV.update(AWS_REGION='us-east-1', AWS_DEFAULT_REGION='us-east-1', AWS_MAX_ATTEMPTS='1', AWS_PAGER='')\nPREFIX = 'stackd-sns-archive-create-' + uuid.uuid4().hex[:10]\nFILE = ROOT / 'testdata/aws/sns/archive_create.json'\nDATA = {'account': '000000000000', 'region': 'us-east-1', 'prefix': PREFIX, 'observations': [], 'cleanup': [], 'source': Path(__file__).read_text()}\nowned = []\n\n\ndef call(label, operation, request, cleanup=False, service='sns'):\n    result = observe(service, operation, request, ENV, paginate=False)\n    DATA['cleanup' if cleanup else 'observations'].append({'label': label, 'service': service, 'operation': operation, 'input': request, 'result': result, 'observed': datetime.datetime.now(datetime.timezone.utc).isoformat()})\n    FILE.write_text(json.dumps(DATA, indent=2) + '\\n')\n    return result\n\n\ndef stop(signum, frame):\n    raise KeyboardInterrupt\n\n\nsignal.signal(signal.SIGTERM, stop)\nsignal.signal(signal.SIGINT, stop)\ntry:\n    identity = call('identity', 'get-caller-identity', {}, service='sts')['output']\n    assert identity['Account'] == DATA['account'] and identity['Arn'] == 'arn:aws:iam::000000000000:user/Delegated', identity\n    for mode in ['inline', 'later']:\n        name = PREFIX + '-' + mode + '.fifo'\n        arn = 'arn:aws:sns:us-east-1:000000000000:' + name\n        owned.append(arn)\n        attrs = {'FifoTopic': 'true'}\n        if mode == 'inline':\n            attrs['ArchivePolicy'] = '{\"MessageRetentionPeriod\":1}'\n        assert call(mode+'-create', 'create-topic', {'Name': name, 'Attributes': attrs})['code'] == 'Success'\n        if mode == 'later':\n            assert call(mode+'-enable', 'set-topic-attributes', {'TopicArn': arn, 'AttributeName': 'ArchivePolicy', 'AttributeValue': '{\"MessageRetentionPeriod\":1}'})['code'] == 'Success'\n        call(mode+'-attributes', 'get-topic-attributes', {'TopicArn': arn})\n        for label, policy in [('same', '{\"MessageRetentionPeriod\":1}'), ('string', '{\"MessageRetentionPeriod\":\"1\"}'), ('whitespace', '{ \"MessageRetentionPeriod\" : 1 }'), ('omitted', None)]:\n            attrs = {'FifoTopic': 'true'}\n            if policy is not None:\n                attrs['ArchivePolicy'] = policy\n            call(mode+'-duplicate-'+label, 'create-topic', {'Name': name, 'Attributes': attrs})\n        call(mode+'-after-duplicates', 'get-topic-attributes', {'TopicArn': arn})\n        call(mode+'-disable', 'set-topic-attributes', {'TopicArn': arn, 'AttributeName': 'ArchivePolicy', 'AttributeValue': '{}'})\n        call(mode+'-duplicate-disabled-empty', 'create-topic', {'Name': name, 'Attributes': {'FifoTopic': 'true', 'ArchivePolicy': '{}'}})\n        call(mode+'-duplicate-disabled-omitted', 'create-topic', {'Name': name, 'Attributes': {'FifoTopic': 'true'}})\n        call(mode+'-disabled-attributes', 'get-topic-attributes', {'TopicArn': arn})\nfinally:\n    for arn in owned:\n        for label, operation, request in [('disable', 'set-topic-attributes', {'TopicArn': arn, 'AttributeName': 'ArchivePolicy', 'AttributeValue': '{}'}), ('delete', 'delete-topic', {'TopicArn': arn}), ('verify-absent', 'get-topic-attributes', {'TopicArn': arn})]:\n            try:\n                call(label, operation, request, cleanup=True)\n            except Exception as error:\n                DATA['cleanup'].append({'label': label, 'arn': arn, 'error': str(error)})\n    FILE.write_text(json.dumps(DATA, indent=2) + '\\n')\n    print(json.dumps({'observations': [(x['label'], x['result']['code']) for x in DATA['observations']], 'cleanup': DATA['cleanup']}))\n"
