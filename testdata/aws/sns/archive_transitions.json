  "capture_program": "import datetime\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport sys\nimport time\nimport uuid\n\nROOT = Path('/home/r/dev/minor/stackd')\nsys.path.insert(0, str(ROOT / 'scripts/aws'))\nfrom aws_cli import observe\n\nPREFIX = 'stackd-sns-replay-state-' + uuid.uuid4().hex[:10]\nENV = {k: v for k, v in os.environ.items() if not k.startswith('AWS_ENDPOINT_URL')}\nENV.update(AWS_REGION='us-east-1', AWS_DEFAULT_REGION='us-east-1', AWS_MAX_ATTEMPTS='1', AWS_PAGER='')\nFILE = ROOT / 'testdata/aws/sns/archive_transitions.json'\nDATA = {'account': '000000000000', 'region': 'us-east-1', 'prefix': PREFIX, 'observations': [], 'receipts': [], 'cleanup': []}\ntopic = queue = subscription = None\nstopped = False\n\ndef now():\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z')\n\ndef save():\n    FILE.write_text(json.dumps(DATA, indent=2) + '\\n')\n\ndef call(label, service, operation, params=None, strict=True, cleanup=False):\n    try:\n        result = observe(service, operation, params or {}, ENV, paginate=False)\n    except Exception as error:\n        if not cleanup:\n            raise\n        result = {'code': 'TransportFailure', 'message': str(error)}\n    DATA['cleanup' if cleanup else 'observations'].append({'label': label, 'service': service, 'operation': operation, 'input': params or {}, 'result': result, 'observed': now()})\n    save()\n    if strict and result['code'] != 'Success':\n        raise RuntimeError(label + ': ' + json.dumps(result))\n    return result.get('output', {})\n\ndef stop(signum, frame):\n    global stopped\n    stopped = True\n\nsignal.signal(signal.SIGTERM, stop)\nsignal.signal(signal.SIGINT, stop)\n\ndef receive(label, seconds):\n    deadline = time.monotonic() + seconds\n    while time.monotonic() < deadline and not stopped:\n        out = call(label, 'sqs', 'receive-message', {'QueueUrl': queue, 'WaitTimeSeconds': 2, 'MaxNumberOfMessages': 10, 'MessageSystemAttributeNames': ['All'], 'MessageAttributeNames': ['All']})\n        for message in out.get('Messages', []):\n            DATA['receipts'].append({'label': label, 'observed': now(), 'message': {k:v for k,v in message.items() if k != 'ReceiptHandle'}})\n            call(label+'-delete', 'sqs', 'delete-message', {'QueueUrl': queue, 'ReceiptHandle': message['ReceiptHandle']})\n        if out.get('Messages'):\n            return True\n    return False\n\ndef status(label, seconds=60):\n    deadline = time.monotonic() + seconds\n    while time.monotonic() < deadline and not stopped:\n        attrs = call(label, 'sns', 'get-subscription-attributes', {'SubscriptionArn': subscription})['Attributes']\n        if attrs.get('ReplayStatus') in ('Completed', 'Failed') or 'ReplayStatus' not in attrs:\n            return attrs\n        time.sleep(2)\n    return attrs\n\ntry:\n    identity = call('identity', 'sts', 'get-caller-identity')\n    if identity.get('Account') != DATA['account'] or identity.get('Arn') != 'arn:aws:iam::000000000000:user/Delegated':\n        raise RuntimeError('Unexpected identity')\n    topic = call('create-topic', 'sns', 'create-topic', {'Name': PREFIX+'.fifo', 'Attributes': {'FifoTopic': 'true', 'ArchivePolicy': '{\"MessageRetentionPeriod\":1}'}})['TopicArn']\n    beginning = call('archive-attributes', 'sns', 'get-topic-attributes', {'TopicArn': topic})['Attributes']['BeginningArchiveTime']\n    queue = call('create-queue', 'sqs', 'create-queue', {'QueueName': PREFIX})['QueueUrl']\n    queue_arn = call('queue-arn', 'sqs', 'get-queue-attributes', {'QueueUrl': queue, 'AttributeNames': ['QueueArn']})['Attributes']['QueueArn']\n    policy = {'Version': '2012-10-17', 'Statement': [{'Effect': 'Allow', 'Principal': {'Service':'sns.amazonaws.com'}, 'Action':'sqs:SendMessage', 'Resource':queue_arn, 'Condition':{'ArnEquals':{'aws:SourceArn':topic}}}]}\n    call('allow-endpoint', 'sqs', 'set-queue-attributes', {'QueueUrl':queue, 'Attributes':{'Policy':json.dumps(policy)}})\n    subscription = call('subscribe', 'sns', 'subscribe', {'TopicArn':topic, 'Protocol':'sqs', 'Endpoint':queue_arn, 'ReturnSubscriptionArn':True})['SubscriptionArn']\n    call('publish-original', 'sns', 'publish', {'TopicArn':topic, 'Message':'archive transition original', 'MessageGroupId':'g', 'MessageDeduplicationId':uuid.uuid4().hex})\n    DATA['baseline_received'] = receive('baseline-receive', 30)\n    print('Replay transitions ready', flush=True)\n    policy['Statement'][0]['Effect'] = 'Deny'\n    call('deny-endpoint', 'sqs', 'set-queue-attributes', {'QueueUrl':queue, 'Attributes':{'Policy':json.dumps(policy)}})\n    replay = json.dumps({'PointType':'Timestamp', 'StartingPoint':beginning})\n    call('denied-replay', 'sns', 'set-subscription-attributes', {'SubscriptionArn':subscription, 'AttributeName':'ReplayPolicy', 'AttributeValue':replay})\n    DATA['denied_status'] = status('denied-status', 90)\n    DATA['denied_receipt'] = receive('denied-receive', 15)\n    policy['Statement'][0]['Effect'] = 'Allow'\n    call('restore-endpoint', 'sqs', 'set-queue-attributes', {'QueueUrl':queue, 'Attributes':{'Policy':json.dumps(policy)}})\n    call('repaired-replay', 'sns', 'set-subscription-attributes', {'SubscriptionArn':subscription, 'AttributeName':'ReplayPolicy', 'AttributeValue':replay})\n    DATA['repaired_receipt'] = receive('repaired-receive', 60)\n    status('repaired-status')\n    call('pending-before-disable', 'sns', 'set-subscription-attributes', {'SubscriptionArn':subscription, 'AttributeName':'ReplayPolicy', 'AttributeValue':replay})\n    call('pending-status-before-disable', 'sns', 'get-subscription-attributes', {'SubscriptionArn':subscription})\n    call('disable-with-attached-replay', 'sns', 'set-topic-attributes', {'TopicArn':topic, 'AttributeName':'ArchivePolicy', 'AttributeValue':'{}'}, strict=False)\n    call('topic-after-disable', 'sns', 'get-topic-attributes', {'TopicArn':topic})\n    DATA['after_disable_status'] = status('status-after-disable', 60)\n    call('publish-after-disable', 'sns', 'publish', {'TopicArn':topic, 'Message':'live after archive disable', 'MessageGroupId':'g', 'MessageDeduplicationId':uuid.uuid4().hex})\n    receive('after-disable-receive', 30)\n    call('cancel-after-disable', 'sns', 'set-subscription-attributes', {'SubscriptionArn':subscription, 'AttributeName':'ReplayPolicy', 'AttributeValue':'{}'}, strict=False)\n    call('after-cancel-status', 'sns', 'get-subscription-attributes', {'SubscriptionArn':subscription})\nexcept Exception as error:\n    DATA['capture_error'] = str(error)\nfinally:\n    if subscription:\n        call('unsubscribe', 'sns', 'unsubscribe', {'SubscriptionArn':subscription}, strict=False, cleanup=True)\n        call('subscription-absence', 'sns', 'get-subscription-attributes', {'SubscriptionArn':subscription}, strict=False, cleanup=True)\n    if topic:\n        call('disable-archive', 'sns', 'set-topic-attributes', {'TopicArn':topic, 'AttributeName':'ArchivePolicy', 'AttributeValue':'{}'}, strict=False, cleanup=True)\n        call('delete-topic', 'sns', 'delete-topic', {'TopicArn':topic}, strict=False, cleanup=True)\n        call('topic-absence', 'sns', 'get-topic-attributes', {'TopicArn':topic}, strict=False, cleanup=True)\n    if queue:\n        call('delete-queue', 'sqs', 'delete-queue', {'QueueUrl':queue}, strict=False, cleanup=True)\n        call('queue-absence', 'sqs', 'get-queue-attributes', {'QueueUrl':queue, 'AttributeNames':['QueueArn']}, strict=False, cleanup=True)\n    DATA['capture_program'] = Path(__file__).read_text()\n    DATA['finished'] = now()\n    save()\n    print(json.dumps({'fixture':str(FILE),'error':DATA.get('capture_error'),'receipts':len(DATA['receipts'])}), flush=True)\n",
