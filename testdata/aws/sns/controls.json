    "findings": [
      {
        "labels": [
          "topic-create-idempotent",
          "topic-create-conflicting-display",
          "topic-after-create-conflict",
          "topic-create-conflicting-tags",
          "topic-tags-after-create"
        ],
        "finding": "Same-name CreateTopic without attributes returned the existing ARN. Conflicting DisplayName and conflicting tags returned InvalidParameter HTTP 400 and retained prior values."
      },
      {
        "labels": [
          "topic-defaults",
          "topic-after-attribute-errors",
          "topic-policy-after-add",
          "topic-add-permission-repeat",
          "topic-remove-permission-repeat",
          "topic-policy-after-remove"
        ],
        "finding": "Native default topic attributes expose an owner-scoped default policy, empty DisplayName, subscription counters and EffectiveDeliveryPolicy; TracingConfig and SignatureVersion are not returned in this default read. Invalid attribute/policy updates leave prior attributes intact. Repeated identical AddPermission and repeated RemovePermission both succeeded."
      },
      {
        "labels": [
          "subscription-defaults",
          "subscription-repeat",
          "subscription-old-after-unsubscribe",
          "subscription-recreate"
        ],
        "finding": "Same-account SQS subscription is confirmed immediately. Repeated Subscribe returns the same ARN; unsubscribe followed by subscribe produces a different ARN. The deleted ARN reads NotFound."
      },
      {
        "labels": [
          "envelope-receive-0",
          "batch-envelope-receive-0",
          "batch-envelope-receive-1",
          "raw-receive-0"
        ],
        "finding": "Publish and PublishBatch produced actual SQS messages. Wrapped delivery retains native SNS metadata, optional Subject and typed MessageAttributes. Raw delivery has the exact input message as SQS Body and exposes attributes as native SQS MessageAttributes, without Subject or the SNS envelope."
      },
      {
        "labels": [
          "filter-attributes-after-errors",
          "filter-body-attributes",
          "filter-attributes-round-0-receive-0",
          "filter-body-round-0-receive-0",
          "filter-attributes-round-1-receive-0",
          "filter-body-round-1-receive-0"
        ],
        "finding": "Each of two crossed attribute/body pairs delivered only its matched candidate to the respective subscription in both rounds. Invalid FilterPolicy/FilterPolicyScope updates returned InvalidParameter and retained the valid attribute filter. This is bounded admission evidence; a 35-second inter-round sleep is not the documented 15-minute full propagation bound."
      },
      {
        "labels": [
          "alarm-policy-wrong-source",
          "recovery-alarm-policy-wrong-source"
        ],
        "finding": "Initial policy containing SNS:* was rejected as action out of service scope. Recovery retained the same scoped service statement but replaced the owner wildcard with the explicit native default action list; it succeeded. Wildcard spelling/case variants were not separately tested."
      },
      {
        "labels": [
          "recovery-alarm-wrong-source-history",
          "recovery-alarm-wrong-source-receive-0",
          "recovery-alarm-authorized-0-receive-0",
          "recovery-alarm-authorized-history-0"
        ],
        "finding": "Wrong SourceArn control produced an explicit Failed action history with SNS:Publish authorization error and no SQS message during the 8-second poll. Correct exact alarm SourceArn policy produced a real alarm notification and Succeeded history. State timestamp to SQS SentTimestamp was 55 ms; the receive finished 926 ms after that state timestamp."
      }
    ],
    "unresolved_or_bounded_observations": [
      "DeleteTopic returned Success and GetTopicAttributes returned NotFound, yet three subscription ARNs still returned attributes seconds later. Explicit owned Unsubscribe then yielded NotFound. No claim of permanent orphaning; asynchronous cascade timing remains unresolved.",
      "ListSubscriptions returned NextToken on the single requested native page. It was retained but not followed. Both global lists discarded one unrelated row before capture; no pagination semantics or exhaustive account listing claimed.",
      "CloudWatch's successful history contains generated default/sms/email protocol payloads; only an SQS subscription existed on that topic. No SMS/email endpoint or delivery was created.",
      "The alarm message includes ActionExecutedAfterMuteWindow=false and Trigger.EvaluateLowSampleCountPercentile as an empty string, while Trigger.Unit is explicit null. These observed fields are preserved rather than synthesized from documentation."
    ],
    "cleanup_verified": "Both initial and recovery finally blocks deleted the alarm before dependent resources, removed subscriptions, deleted exact owned topic/queue handles and obtained empty alarm descriptions or native NotFound/NonExistentQueue reads. cleanup_before_recovery and cleanup retain separate verified outcomes."
  },
