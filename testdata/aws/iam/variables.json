      "name": "missing_resource",
      "policy": {
        "Statement": {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::example/${aws:username}/*"
        },
        "Version": "2012-10-17"
      },
      "request": {
        "action": "s3:GetObject",
        "resource": "arn:aws:s3:::example/alice/file",
