    "contextEligibility": "String condition probes use s3:ExistingObjectTag/owner for s3:GetObject; interpolation uses aws:PrincipalTag keys. Diagnostic probes using unrelated s3:prefix or fabricated test:* keys were excluded because service-context eligibility is outside policy-template evaluation.",
    "command": [
      "aws",
      "iam",
      "simulate-custom-policy",
      "--region",
      "us-east-1",
      "--endpoint-url",
      "https://iam.amazonaws.com",
      "--policy-input-list",
      "<policy JSON>",
      "--action-names",
      "<request.action>",
      "--resource-arns",
      "<request.resource>",
      "--context-entries",
      "<request.context entries with ContextKeyType string>",
      "--output",
      "json",
      "--no-cli-pager"
    ],
    "commandNote": "The --context-entries argument is omitted when request.context is empty. Each recorded context value uses ContextKeyType string."
  },
