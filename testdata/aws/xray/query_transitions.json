  "purpose": "Local documented syntax and state-transition contracts, not additional native captures. Native observations remain the wire projection oracle.",
  "exclusions": {
    "initial-summaries-poll-0": "Intermediate empty index poll; initial-summaries-poll-1 converged.",
    "broken-summaries-poll-0": "Intermediate empty index poll; broken-summaries-poll-1 converged.",
    "completion-summaries-poll-0": "Intermediate pre-completion projection; completion-summaries-poll-1 converged.",
    "initial-service-graph": "Incomplete graph index before service-graph-by-arn-later converged.",
    "destination-isolated": "Tracing destination management is outside classic trace-query/group replay.",
    "group-filter-after-update": "Asynchronous old group filter; group-filter-after-propagation is converged.",
    "service-graph-before-group-update": "Fourteen seconds after accepted completion/callee arrival the graph still has six roots and an inferred worker; service-graph-final-v2 converges to the completed root and reported worker.",
    "service-graph-immediate-group-update": "Immediate graph index before version propagation; final graph establishes old-version retention.",
    "v2-service-graph-poll-0": "Graph index has not ingested v2 yet; service-graph-final-v2 is converged.",
    "group-v2-only-service-window": "Intermediate empty v2 graph; service-graph-final-v2-only-window converged.",
    "summaries-0": "Intermediate empty projection poll; summaries-1 converged.",
    "service-graph-deleted-group": "Deletion propagation, not historical retention: trace_aggregate_edges supplemental_captures[6] historical-window-after-delete-2 and new-window-after-delete-2 both converge to HTTP 400.",
    "initial-initial-receipt": "Empty arrival index immediately after PutTraceSegments; initial-receipt-before-update converges for the identical window.",
    "new-arrival-after-update-0": "Empty arrival index immediately after late child/completion; new-arrival-after-update-2 converges for the identical window.",
    "new-arrival-after-update-1": "Empty arrival index before new-arrival-after-update-2 converges for the identical window.",
    "initial-delete-group-0": "Group was created one second before ingestion and this group's index never became visible before deletion; supplemental_captures[6] waits 30 seconds after creation and baseline-group-4 converges.",
    "initial-delete-group-1": "Same unpropagated freshly-created group as initial-delete-group-0; delayed-creation baseline-group-4 supplies the positive membership oracle.",
    "initial-delete-group-2": "Same unpropagated freshly-created group as initial-delete-group-0; delayed-creation baseline-group-4 supplies the positive membership oracle.",
    "initial-delete-group-3": "Same unpropagated freshly-created group as initial-delete-group-0; delayed-creation baseline-group-4 supplies the positive membership oracle.",
    "initial-delete-group-4": "Same unpropagated freshly-created group as initial-delete-group-0; delayed-creation baseline-group-4 supplies the positive membership oracle.",
    "initial-delete-group-5": "Same unpropagated freshly-created group as initial-delete-group-0; delayed-creation baseline-group-4 supplies the positive membership oracle.",
    "initial-delete-group-6": "Same unpropagated freshly-created group as initial-delete-group-0; delayed-creation baseline-group-4 supplies the positive membership oracle.",
    "initial-delete-group-7": "Same unpropagated freshly-created group as initial-delete-group-0; delayed-creation baseline-group-4 supplies the positive membership oracle.",
    "initial-delete-group-8": "Same unpropagated freshly-created group as initial-delete-group-0; delayed-creation baseline-group-4 supplies the positive membership oracle.",
    "deleted-group-old-window-0": "Deletion propagation; combined-group-d and supplemental_captures[6] historical-window-after-delete-2 converge to HTTP 400.",
    "deleted-group-new-window-0": "Deletion propagation; deleted-group-new-window-1 converges to HTTP 400.",
    "deleted-group-old-window-1": "Deletion propagation; combined-group-d and supplemental_captures[6] historical-window-after-delete-2 converge to HTTP 400.",
    "fault-group-new-window-0": "Empty group index immediately after first fault match; fault-group-new-window-1 converges for the identical window.",
    "baseline-group-0": "Incomplete native group graph index; baseline-group-4 converges before deletion.",
    "baseline-group-1": "Incomplete native group graph index; baseline-group-4 converges before deletion.",
    "baseline-group-2": "Incomplete native group graph index; baseline-group-4 converges before deletion.",
    "baseline-group-3": "Incomplete native group graph index; baseline-group-4 converges before deletion.",
    "historical-window-after-delete-0": "Deletion propagation, disproven by historical-window-after-delete-2 returning HTTP 400 for the identical historical window.",
    "historical-window-after-delete-1": "Deletion propagation, disproven by historical-window-after-delete-2 returning HTTP 400 for the identical historical window.",
    "new-window-after-delete-0": "Deletion propagation; new-window-after-delete-2 converges to HTTP 400.",
    "new-window-after-delete-1": "Deletion propagation; new-window-after-delete-2 converges to HTTP 400.",
    "ungrouped-new-window-0": "Late child has not propagated into the graph; ungrouped-new-window-2 contains its completed contribution.",
    "ungrouped-new-window-1": "Only unrelated concurrent cause-branch services have propagated; ungrouped-new-window-2 contains the owned late child."
  },
