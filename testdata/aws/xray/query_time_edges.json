  "executed_source": "async function call(service, operation, input) { const argv=['aws',service,operation,'--region','us-west-2','--no-cli-pager','--no-paginate','--cli-input-json',JSON.stringify(input),'--output','json']; const started=Date.now();const p=Bun.spawn(argv,{stdout:'pipe',stderr:'pipe',env:{...process.env,AWS_PAGER:'',AWS_MAX_ATTEMPTS:'1'}});const [out,err,status]=await Promise.all([new Response(p.stdout).text(),new Response(p.stderr).text(),p.exited]);if(status!==0)throw Error(operation+': '+err);return {operation,input,request_started_ms:started,response_observed_ms:Date.now(),result:{code:'Success',output:JSON.parse(out)}}; }\nconst original=JSON.parse(await Bun.file('testdata/aws/xray/trace_queries.json').text());const identity=await call('sts','get-caller-identity',{});if(identity.result.output.Account!=='000000000000')throw Error('unexpected account');const initial=original.observations.find(o=>o.label==='put-owned-instrumented-traces');const completion=original.observations.find(o=>o.label==='put-progress-completion-and-missing-child');const target=JSON.parse(completion.input.TraceSegmentDocuments[0]);const filter='annotation.owner = \"'+original.prefix+'\" AND annotation.kind = \"'+target.annotations.kind+'\"';const cases=[['original-receipt-after-completion',initial.request_started_ms/1000-10,initial.response_observed_ms/1000+30],['completion-receipt',completion.request_started_ms/1000-10,completion.response_observed_ms/1000+30],['receipt-gap',initial.response_observed_ms/1000+60,completion.request_started_ms/1000-60]];const observations=[];for(const [label,start,end]of cases){observations.push({label,...await call('xray','get-trace-summaries',{StartTime:start,EndTime:end,TimeRangeType:'Event',FilterExpression:filter,Sampling:false})});}console.log(JSON.stringify({region:'us-west-2',identity:identity.result.output,trace_id:target.trace_id,observations},null,2));"
