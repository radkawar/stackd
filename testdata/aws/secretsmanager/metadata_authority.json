  "source": "import json, os, sys, time, uuid\nfrom pathlib import Path\nsys.path.insert(0, '/home/r/dev/minor/stackd/scripts/aws')\nfrom aws_cli import observe\nroot=Path('/home/r/dev/minor/stackd')\npath=root/'testdata/aws/secretsmanager/metadata_authority.json'\nenv={k:v for k,v in dict(os.environ,AWS_REGION='us-west-2',AWS_DEFAULT_REGION='us-west-2',AWS_PAGER='',AWS_MAX_ATTEMPTS='1').items() if not k.startswith('AWS_ENDPOINT_URL')}\nname='stackd-secret-metadata-'+uuid.uuid4().hex[:10]\nresult={'account':'000000000000','region':'us-west-2','name':name,'source':Path(__file__).read_text(),'observations':[],'cleanup':{}}\nprimary=replica=managed=None\nconnection=False\n\ndef call(label,service,operation,payload,region='us-west-2'):\n started=int(time.time()*1000)\n value=observe(service,operation,payload,dict(env,AWS_REGION=region,AWS_DEFAULT_REGION=region),paginate=False)\n result['observations'].append({'label':label,'service':service,'operation':operation,'region':region,'input':payload,'request_started_ms':started,'request_finished_ms':int(time.time()*1000),'result':value})\n path.write_text(json.dumps(result,indent=2)+'\\n')\n print(label,value['code'],flush=True)\n return value\n\ndef good(value):\n if value['code']!='Success': raise RuntimeError(value)\n return value['output']\n\ndef absent(service,operation,payload,region,label):\n for attempt in range(60):\n  row=call(label+'-'+str(attempt),service,operation,payload,region)\n  if row['code']=='ResourceNotFoundException':result['cleanup'][label]='independently absent';return\n  time.sleep(2)\n raise RuntimeError('Resource still present: '+label)\n\ntry:\n identity=good(call('identity','sts','get-caller-identity',{}))\n if identity['Account']!='000000000000': raise RuntimeError('Wrong account')\n connection=True\n good(call('create-connection','events','create-connection',{'Name':name,'AuthorizationType':'BASIC','AuthParameters':{'BasicAuthParameters':{'Username':'owned-user','Password':'owned-inert-value'}}}))\n managed=good(call('describe-connection','events','describe-connection',{'Name':name}))['SecretArn']\n primary=good(call('create-primary','secretsmanager','create-secret',{'Name':name,'SecretString':'owned-inert-value'}))['ARN']\n good(call('replicate','secretsmanager','replicate-secret-to-regions',{'SecretId':primary,'AddReplicaRegions':[{'Region':'us-east-2'}]}))\n replica=primary.replace(':us-west-2:',':us-east-2:')\n for attempt in range(45):\n  row=good(call('wait-replica-'+str(attempt),'secretsmanager','describe-secret',{'SecretId':primary}))\n  if row['ReplicationStatus'][0]['Status']=='InSync':break\n  time.sleep(2)\n else:raise RuntimeError('Replica did not synchronize')\n policy=json.dumps({'Version':'2012-10-17','Statement':[{'Effect':'Allow','Principal':{'AWS':'arn:aws:iam::000000000000:root'},'Action':'secretsmanager:GetSecretValue','Resource':'*'}]})\n for label,secret,region in [('managed',managed,'us-west-2'),('replica',replica,'us-east-2')]:\n  call(label+'-tag','secretsmanager','tag-resource',{'SecretId':secret,'Tags':[{'Key':'owned','Value':'metadata'}]},region)\n  call(label+'-untag','secretsmanager','untag-resource',{'SecretId':secret,'TagKeys':['owned']},region)\n  call(label+'-put-policy','secretsmanager','put-resource-policy',{'SecretId':secret,'ResourcePolicy':policy,'BlockPublicPolicy':True},region)\n  call(label+'-get-policy','secretsmanager','get-resource-policy',{'SecretId':secret},region)\n  call(label+'-delete-policy','secretsmanager','delete-resource-policy',{'SecretId':secret},region)\n  call(label+'-description','secretsmanager','update-secret',{'SecretId':secret,'Description':'owned metadata probe'},region)\n call('managed-direct-delete','secretsmanager','delete-secret',{'SecretId':managed,'ForceDeleteWithoutRecovery':True})\nfinally:\n if connection:\n  call('cleanup-connection','events','delete-connection',{'Name':name})\n  absent('events','describe-connection',{'Name':name},'us-west-2','connection')\n if managed:absent('secretsmanager','describe-secret',{'SecretId':managed},'us-west-2','managed-secret')\n if primary:\n  call('cleanup-remove-replica','secretsmanager','remove-regions-from-replication',{'SecretId':primary,'RemoveReplicaRegions':['us-east-2']})\n  if replica:absent('secretsmanager','describe-secret',{'SecretId':replica},'us-east-2','replica')\n  call('cleanup-primary','secretsmanager','delete-secret',{'SecretId':primary,'ForceDeleteWithoutRecovery':True})\n  absent('secretsmanager','describe-secret',{'SecretId':primary},'us-west-2','primary')\n path.write_text(json.dumps(result,indent=2)+'\\n')\n",
