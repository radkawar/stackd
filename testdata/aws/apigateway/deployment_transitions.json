{
  "source": "Documented deployment snapshots and automatic deployment contract; local regression scenarios, not a native AWS capture",
  "steps": [
    {"service":"http","operation":"UpdateRoute","input":{"ApiId":"$HTTP_API","RouteId":"$HTTP_ROUTE","AuthorizationType":"AWS_IAM"},"status":200},
    {"service":"http","operation":"CreateDeployment","input":{"ApiId":"$HTTP_API","StageName":"$default"},"status":403,"reopen":true},
    {"service":"http","operation":"UpdateRoute","input":{"ApiId":"$HTTP_API","RouteId":"$HTTP_ROUTE","AuthorizationType":"NONE"},"status":403},
    {"service":"http","operation":"UpdateStage","input":{"ApiId":"$HTTP_API","StageName":"$default","AutoDeploy":true},"status":200},
    {"service":"http","operation":"UpdateRoute","input":{"ApiId":"$HTTP_API","RouteId":"$HTTP_ROUTE","AuthorizationType":"AWS_IAM"},"status":403},
    {"service":"http","operation":"UpdateRoute","input":{"ApiId":"$HTTP_API","RouteId":"$HTTP_ROUTE","AuthorizationType":"NONE"},"status":200,"reopen":true},
    {"service":"rest","operation":"UpdateMethod","input":{"RestApiId":"$REST_API","ResourceId":"$REST_RESOURCE","HttpMethod":"GET","PatchOperations":[{"Op":"replace","Path":"/authorizationType","Value":"AWS_IAM"}]},"status":200},
    {"service":"rest","operation":"CreateDeployment","input":{"RestApiId":"$REST_API","StageName":"dev"},"status":403,"reopen":true},
    {"service":"rest","operation":"UpdateMethod","input":{"RestApiId":"$REST_API","ResourceId":"$REST_RESOURCE","HttpMethod":"GET","PatchOperations":[{"Op":"replace","Path":"/authorizationType","Value":"NONE"}]},"status":403},
    {"service":"rest","operation":"CreateDeployment","input":{"RestApiId":"$REST_API","StageName":"dev"},"status":200,"reopen":true}
  ]
}
