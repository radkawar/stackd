  "name": "stackd-oauth-shape-b9bd7eb17b",
  "source": "\"\"\"Cheap owned OAuth secret-shape capture; reserved .invalid endpoint cannot receive credentials.\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport time\nimport uuid\nfrom aws_cli import observe\n\nname = 'stackd-oauth-shape-' + uuid.uuid4().hex[:10]\nenv = dict(os.environ, AWS_REGION='us-west-2', AWS_DEFAULT_REGION='us-west-2', AWS_PAGER='', AWS_MAX_ATTEMPTS='1')\nfor key in list(env):\n    if key.startswith('AWS_ENDPOINT_URL'):\n        del env[key]\nout = Path(__file__).resolve().parents[2] / 'testdata/aws/eventbridge/connection_oauth_secret.json'\nrecord = {'name': name, 'source': Path(__file__).read_text(), 'value_provenance': 'Synthetic inert credentials. Reserved .invalid host prevents transmission to any third party.', 'observations': []}\ndef call(label, service, operation, params):\n    response = observe(service, operation, params, env, paginate=False)\n    record['observations'].append({'label': label, 'service': service, 'operation': operation, 'input': params, 'result': response})\n    out.write_text(json.dumps(record, indent=2)+'\\n')\n    print(label, response['code'], flush=True)\n    return response\nsecret = None\ntry:\n    result = call('create', 'events', 'create-connection', {'Name': name, 'AuthorizationType': 'OAUTH_CLIENT_CREDENTIALS', 'AuthParameters': {'OAuthParameters': {'AuthorizationEndpoint': 'https://owned.invalid/oauth', 'HttpMethod': 'POST', 'ClientParameters': {'ClientID': 'owned-client', 'ClientSecret': 'owned-inert-secret'}, 'OAuthHttpParameters': {'HeaderParameters': [{'Key': 'x-owned-public', 'Value': 'public'}, {'Key': 'x-owned-private', 'Value': 'owned-private', 'IsValueSecret': True}], 'BodyParameters': [{'Key': 'grant_type', 'Value': 'client_credentials'}]}}}})\n    if result['code'] != 'Success':\n        raise RuntimeError(result)\n    info = call('describe', 'events', 'describe-connection', {'Name': name})\n    secret = info['output']['SecretArn']\n    call('secret-value', 'secretsmanager', 'get-secret-value', {'SecretId': secret})\nfinally:\n    call('cleanup-delete', 'events', 'delete-connection', {'Name': name})\n    for attempt in range(30):\n        r = call('cleanup-connection-'+str(attempt), 'events', 'describe-connection', {'Name': name})\n        if r['code'] == 'ResourceNotFoundException':\n            record['connection_absent'] = True\n            break\n        time.sleep(2)\n    if secret:\n        for attempt in range(30):\n            r = call('cleanup-secret-'+str(attempt), 'secretsmanager', 'describe-secret', {'SecretId': secret})\n            if r['code'] == 'ResourceNotFoundException':\n                record['secret_absent'] = True\n                break\n            time.sleep(2)\n    out.write_text(json.dumps(record, indent=2)+'\\n')\n",
