{
  "sources": [
    "https://docs.aws.amazon.com/awscloudtrail/latest/APIReference/API_EventSelector.html",
    "https://docs.aws.amazon.com/kms/latest/developerguide/logging-using-cloudtrail.html",
    "testdata/aws/cloudtrail/service_management_events.json"
  ],
  "cases": [
    {
      "name": "all-management",
      "selector": {"IncludeManagementEvents": true, "ReadWriteType": "All"},
      "events": ["DisableKey", "Encrypt"]
    },
    {
      "name": "crypto-is-read-management",
      "selector": {"IncludeManagementEvents": true, "ReadWriteType": "ReadOnly"},
      "events": ["Encrypt"]
    },
    {
      "name": "key-state-is-write-management",
      "selector": {"IncludeManagementEvents": true, "ReadWriteType": "WriteOnly"},
      "events": ["DisableKey"]
    },
    {
      "name": "kms-exclusion-preserves-history",
      "selector": {"IncludeManagementEvents": true, "ReadWriteType": "All", "ExcludeManagementEventSources": ["kms.amazonaws.com"]},
      "events": []
    }
  ]
}
