[Unit]
Description=Stackd Lambda managed-instance guest agent
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/stackd-lambda-agent -config /etc/stackd-lambda-agent.json
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
