#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Check pushed commits, not an unrelated or partially edited working tree.
# Full tests and generation checks belong to the explicit make check gate.
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/stackd-push.XXXXXXXX")
trap 'rm -rf "$snapshot"' EXIT
mapfile -t git_local_env < <(git rev-parse --local-env-vars)
empty_tree=$(git hash-object -t tree /dev/null)
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleted refs and tags that do not point to commits have no Go tree to check.
    if [[ "$local_oid" =~ ^0+$ ]] || ! revision=$(git rev-parse --verify "$local_oid^{commit}" 2>/dev/null); then
        continue
    fi
    base=$empty_tree
    if git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
        base=$remote_oid
    fi
    mapfile -d '' changed < <(git diff --name-only -z --no-renames "$base" "$revision" -- '*.go' go.mod go.sum)
    if (( ${#changed[@]} == 0 )); then
        continue
    fi
    tree="$snapshot/$revision"
    mkdir -p "$tree"
    git archive "$revision" | tar -x -C "$tree"
    (
        unset "${git_local_env[@]}"
        cd "$tree"
        packages=()
        declare -A seen=()
        shopt -s nullglob
        for file in "${changed[@]}"; do
            if [[ "$file" == go.mod || "$file" == go.sum ]]; then
                packages=(./...)
                break
            fi
            directory=.
            if [[ "$file" == */* ]]; then
                directory="./${file%/*}"
            fi
            sources=("$directory"/*.go)
            if (( ${#sources[@]} )) && [[ ! -v "seen[$directory]" ]]; then
                # Directories containing only build-ignored tools are not Go
                # packages. Preserve invalid/buildable packages so vet reports
                # their errors; standalone tools are checked by filename.
                selection=$(go list -e -f '{{if and .IgnoredGoFiles (not (or .GoFiles .CgoFiles .TestGoFiles .XTestGoFiles .InvalidGoFiles))}}skip{{else}}check{{end}}' "$directory")
                if [[ "$selection" == skip ]]; then
                    seen["$directory"]=1
                    continue
                fi
                packages+=("$directory")
                seen["$directory"]=1
            fi
        done
        if (( ${#packages[@]} )); then
            printf 'Checking pushed Go packages for %s: %s\n' "$local_ref" "${packages[*]}"
            go vet "${packages[@]}"
            go tool staticcheck "${packages[@]}"
        fi
    )
done
